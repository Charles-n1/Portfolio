---
import Deco from "../components/Deco.astro";
---

<loisirs id="idlois">
    <Deco src="/rect_23.svg" top="calc(var(--list-len-opened) + 2550px)" left="1350.5px" width="600px" height="300px" rotate="-44deg"/>
    <Deco src="/rect_23.svg" top="calc(var(--list-len-opened) + 2133px)" left="1782px" width="600px" height="300px" rotate="-44deg"/>
    <Deco src="/rect_12.svg" top="calc(var(--list-len-opened) + 2680px)" left="-120px" width="500px" rotate="-33deg"/>
    <Deco src="/rect_24_eclair7.svg" top="calc(var(--list-len-opened) + 2280px)" left="-130.5px" width="570px" height="300px" rotate="-33deg"/>
    <Deco src="/rect_w6.svg" top="calc(var(--list-len-opened) + 3450px)" left="1500px" width="550px" rotate="-44deg"/>
    <Deco src="/rect_2.svg" top="calc(var(--list-len-opened) + 3550px)" left="1250px" width="550px" rotate="-44deg"/>
    <Deco src="/rect_4.svg" top="calc(var(--list-len-opened) + 3115px)" left="1550px" width="200px" height="170px" rotate="-44deg"/>
    <Deco src="/rect_w6.svg" top="calc(var(--list-len-opened) + 3155px)" left="1650px" width="200px" height="60px" rotate="-44deg"/>
    <Deco src="/rect_3.svg" top="calc(var(--list-len-opened) + 3650px)" left="-160px" width="550px" height="570px" rotate="-44deg"/>
    <div class="mtitle"> D'autres loisirs: </div>
    <div class="list">
        <div class="title">∘ Vtuber</div> <img class="vtu" src="../../public/gear.svg">
        <div class="title">∘ Mario Kart Speedrunner</div> <img class="mk8" src="../../public/gear.svg">
        <div class="title">∘ Minecraft</div> <img class="mine" src="../../public/gear.svg">
    </div>
</loisirs>

<style>
    loisirs {
        display: grid;
        align-content: center;

        min-height: 100vh;
        min-width: 100wh;
        font-size: 55px;
        border: 10px solid green;
    }
    .list {
        display: grid;
        grid-template: repeat(3, 120px) / 750px 100px ;
        max-width: 100vw;
        justify-content: center;
        align-items: center;

        border: 10px solid pink;
        margin-top: 30px;
        margin-bottom: 780px;
    }
    .mtitle {
        margin-left: 300px;      /* un peu à droite : ajuste la valeur */
        margin-top: 400px;
    }
    .mtitle:hover {
        color: rgba(0, 127, 255);
    }
    .title:hover {
        color: rgba(0, 127, 255);
    }
    .title {
        ;
    }
    .mine {
        height: 60px;
    }
    .vtu {
        height: 60px;
    }
    .mk8 {
        height: 60px;
    }
</style>