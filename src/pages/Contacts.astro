---
import Rs from "../components/Rs.astro"
import Deco from "../components/Deco.astro";
---

<contacts id="idcont">
    <Deco src="/eclair_8.svg" top="calc(var(--list-len-opened) + 3540px)" left="-100px" width="130%" rotate="2deg"/>
    <Deco src="/rect_5_coupe4.svg" top="calc(var(--list-len-opened) + 4224.6px)" left="1469.9px" width="510.3px"/>
    <div class="content">
        <div class="txt">hello</div>
        <div class="list">
            <Rs src="../../public/gear.svg" link="https://agar.io"/>
            <Rs src="../../public/gear.svg" link="https://diep.io"/>
            <Rs src="../../public/gear.svg" link="https://moomoo.io"/>
            <Rs src="../../public/gear.svg" link="https://slither.io"/>
        </div>
        <div class="txt"> don't forget !</div>
    </div>
</contacts>

<style>
    contacts {
        ;
    }
    .content {
        display: grid;
        grid-template: 1fr / 1fr 1fr 1fr;
        align-content: center;
        justify-items: center;
        align-items: center;

        min-height: 40vh;
        max-height: 50vh;
        max-width: 100vw;
        border: 10px solid yellow;
        overflow-y: clip;
    }
    .list {
        display: grid;
        grid-template: 1fr 1fr / 1fr 1fr;
        min-width: 20vw;
        min-height: 30vh;
        gap: 20px;

        justify-items: center;
        align-items: center;
        border: 10px solid black;
    }
    .txt {
        font-size: 35px;
    }
    .txt:hover {
        color: blue;
    }
</style>
