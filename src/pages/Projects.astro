---
import Project from "../components/Project.astro"
import Deco from "../components/Deco.astro"
---

<projects id="idproj">
    <Deco src="/rect_5.svg" bottom="-378px" left="-160px" width="375px" height="112px" rotate="-34.5deg" />
    <Deco src="/eclair_3.svg" top="calc(400px + 50vh - 28.2vw - 110px)" left="-15%" width="130%" rotate="-4deg"/>
    <span class="mtitle"> Mes projets </span>
    <span class="list">
        <Project title="zappy" desc="zap zap zappy !!" img="../../public/gear.svg" link="https://diep.io" />
        <Project title="zappy" desc="zap zap zappy !!" img="../../public/gear.svg" link="https://agar.io" />
        <Project title="zappy" desc="zap zap zappy !!" img="../../public/gear.svg" link="https://slither.io" />

        <Project title="zappy" desc="zap zap zappy !!" img="../../public/gear.svg" link="https://moomoo.io" />
        <Project title="zappy" desc="zap zap zappy !!" img="../../public/gear.svg" link="https://diep.io" />
        <Project title="zappy" desc="zap zap zappy !!" img="../../public/gear.svg" link="https://agar.io" />

        <Project class="extra" title="zappy" desc="zap zap zappy !!" img="../../public/gear.svg" link="https://diep.io" />
        <Project class="extra" title="zappy" desc="zap zap zappy !!" img="../../public/gear.svg" link="https://diep.io" />
        <Project class="extra" title="zappy" desc="zap zap zappy !!" img="../../public/gear.svg" link="https://diep.io" />
    </span>
    <details>
        <summary>
            See more projects
        </summary>
    </details>
</projects>

<style>
    projects {
        display: grid;
        grid-template: auto auto auto / auto;
        border: 10px solid pink;
        justify-content: center;
        gap: 40px;
    }
    projects:has(details[open]) {
        .extra {
            display: grid;
        }
    }
    projects:has(details:not([open])) {
        .extra {
            display: none;
        }
    }
    .list {
        display: grid;
        grid-template-columns: repeat(3, 300px);   /* seulement les colonnes */
        grid-auto-rows: 300px;
        justify-content: center;
        align-content: center;
        gap: 80px;

        min-height: 80vh;
        min-width: 100wh;
        border: 10px solid blue;
    }
    button {
        border: none;
        background: none;
        font-size: 25px;
    }
    button:hover {
        color: rgba(0,127, 255);
    }
    details {
        justify-self: center;
        font-size: 40px;
    }
    .mtitle {
        font-size: 55px;
        margin-left: -110px;
    }
</style>
